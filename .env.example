# Optional. Without these, Pad still runs and saves everything on this device.
# Add them to turn on the sign-in button and sync across devices.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Turns on writing up a note, tidying dictation, asking a question of
# your notes, and ordering what is outstanding. Without it all four still work,
# more roughly, on the device. GPT-4o is what this asks for.
#
# Copy this file to .env.local, put the key in, and restart the server —
# environment variables are read at startup, so a running one will not see it.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# A fallback, for anyone who had this set before GPT-4o became the default.
# Only read when OPENAI_API_KEY is empty: if both are set, OpenAI wins.
# ANTHROPIC_API_KEY=
