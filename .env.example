# Supabase — Project Settings → API. Both are safe in a browser; row level
# security is what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Claude builds and runs the tools. console.anthropic.com → API Keys.
# Server-side only — never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Paystack, for paid tools. dashboard.paystack.com → Settings → API Keys.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

# Only needed for paid tools. Supabase → Project Settings → API → "service_role".
# Server-side only. This key bypasses every security rule — never expose it to a
# browser and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
