# Copy to .env.local and fill in. Only the three Supabase keys are required —
# without the rest the game still runs, it just can't send email or take money.

# --- Required -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role. Server-only: never expose this to a browser. It is also the
# fallback signing key for the player cookie.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email --------------------------------------------------------------
# Without a key, verification codes are logged to the console instead of sent,
# which is enough to play locally.
RESEND_API_KEY=
EMAIL_FROM="Spendbox <notifications@spendbox.site>"

# --- Payments -----------------------------------------------------------
# Enables stakes, power-ups and buying lives. Point Paystack's webhook at
# https://your-domain/api/paystack/webhook
#
# The secret key is the only one needed. Both payment methods are started
# server-side — `/transaction/initialize` for a card, `/charge` for a bank
# transfer — so no public key is ever handed to a browser.
PAYSTACK_SECRET_KEY=

# --- Admin (/admin) -----------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Or: any signed-in Supabase user on this comma-separated list.
ADMIN_EMAILS=

# --- Optional -----------------------------------------------------------
# Signs the six-month player cookie. Defaults to the service-role key.
PLAYER_SESSION_SECRET=
# Canonical public URL, for Paystack callbacks behind a proxy.
APP_URL=

# --- Notifications (web push) -------------------------------------------
# Generate a pair once with `npm run vapid`. Without them the toggle in /me
# says notifications are unavailable and nothing is sent — same as email
# without a Resend key.
#
# Do not rotate these casually: a subscription is bound to the public key that
# created it, so a new pair silently unsubscribes everyone who had opted in.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services. mailto: or https:, and required by Firefox.
VAPID_SUBJECT=mailto:spendbox@gmail.com

# --- Scheduled jobs -----------------------------------------------------
# Vercel calls cron routes with `Authorization: Bearer $CRON_SECRET`. Without
# it the daily "your lives are back" push never runs — the route refuses any
# caller it cannot identify, and an admin session is the only other way in.
CRON_SECRET=
