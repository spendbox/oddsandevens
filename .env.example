# Optional. Without these, Pad still runs and saves everything on this device.
# Add them to turn on the sign-in button and sync across devices.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Turns on Writing help (the Ask button) and the Library's filing.
# Without it, both are simply absent. GPT-4o is what this asks for.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# A fallback, for anyone who had this set before GPT-4o became the default.
# Only read when OPENAI_API_KEY is empty.
# ANTHROPIC_API_KEY=
