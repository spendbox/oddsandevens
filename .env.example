# ---------------------------------------------------------------------------
# Supabase — Project Settings → API.
# Both of these are safe in a browser; row level security is what protects the
# data, not the key.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The same two values again, without the prefix. Worth setting, and here is why.
#
# A NEXT_PUBLIC_ name is compiled into the build rather than looked up when
# somebody visits, so a deployment built before you added one cannot see it
# however long it has been sitting in the Vercel dashboard — and neither can a
# Preview deployment built by a job that only had the Production values. That
# gap is what "the variable is set but the site says it is not" means, and it
# took spendbox.site down once.
#
# These two have no prefix, so nothing compiles them in and they are read fresh
# on every request: saving them in Vercel takes effect immediately, no redeploy.
# Set both pairs and the question stops being able to come up. Visit /setup on
# any deployment to see which of them it can actually see.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# The "service_role"/"secret" key, from the same page.
#
# Spendbox does not run without it. Every coin spent, every pattern issued,
# every answer judged and every winner decided goes through this key, because a
# browser is trusted with none of those. Server-side only — never give it a
# NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Paystack — dashboard.paystack.com → Settings → API Keys & Webhooks.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Resend — resend.com → API Keys. All outbound email goes through it, not
# through Supabase's built-in mailer, which is rate limited hard enough that
# password resets quietly stop arriving under real traffic.
#
# EMAIL_FROM is optional: unset, mail goes out as
# "Spendbox <notifications@spendbox.site>". Set it only to change the display
# name or the mailbox, and keep it on spendbox.site — that is the domain
# verified in Resend, and Resend refuses to send from any other.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
# EMAIL_FROM=Spendbox <notifications@spendbox.site>

# ---------------------------------------------------------------------------
# Who can open the admin dashboard at /admin. Comma-separated emails, no
# NEXT_PUBLIC_ prefix. Leave it unset and nobody can — including you, which is
# the most common reason /admin appears to be missing. Visit /admin while
# signed in and the page will tell you exactly what to set.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=spendbox@gmail.com

# ---------------------------------------------------------------------------
# Optional. Where Paystack sends players back to after checkout. Left unset,
# the app works it out from the incoming request, which is right for local
# development, Vercel previews and production alike. Set it only if something
# in front of the app rewrites the host.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://www.spendbox.site
