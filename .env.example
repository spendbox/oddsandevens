# Optional. Without these, Pad still runs and saves everything on this device.
# Add them to turn on the sign-in button and sync across devices.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Turns on Writing help (the sparkle button).
# Without it, the button is simply absent.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
